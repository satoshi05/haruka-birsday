# Private original media (never commit)
assets/photos/raw/*
!assets/photos/raw/.gitkeep
assets/videos/raw/*
!assets/videos/raw/.gitkeep

# Private working selections (publish only after explicit approval and optimization)
assets/photos/selected/*
!assets/photos/selected/.gitkeep
assets/videos/selected/*
!assets/videos/selected/.gitkeep

# Generated media-analysis artifacts
assets/video-thumbnails/*
!assets/video-thumbnails/.gitkeep
data/contact-sheets/
data/thumbnails/
data/analysis-cache/
data/media-analysis.json
data/*.tmp

# Local work and exports
tmp/
temp/
cache/
exports/
*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / frontend tooling
node_modules/
dist/
.vite/
.parcel-cache/
.next/
coverage/

# Environment files
.env
.env.*
!.env.example

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
